<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_school_access">
            <field name="name">School</field>
            <field name="sequence">21</field>
        </record>
         <record model="res.groups.privilege" id="res_group_privilege_school_role">
            <field name="name">student</field>
            <field name="category_id" ref="module_school_access"/>
        </record>

        <record id="group_school_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_group_privilege_school_role"/>
        </record>


        <record id="group_school_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="privilege_id" ref="res_group_privilege_school_role"/>
            <field name="implied_ids" eval="[(4, ref('group_school_user'))]"/>
        </record>
         <record id="ir_rule_admin_access" model="ir.rule">
            <field name="name">admin full access</field>
            <field name="model_id" ref="school.model_student_student"/>
            <field name="groups" eval="[(4,ref('school.group_school_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="ir_rule_student" model="ir.rule">
            <field name="name">Student Own Record</field>
            <field name="model_id" ref="school.model_student_student"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4,ref('school.group_school_user'))]"/>
        </record>

         <record id="ir_rule_admin_attendance_access" model="ir.rule">
            <field name="name">admin full access</field>
            <field name="model_id" ref="school.model_attendance_attendance"/>
            <field name="groups" eval="[(4,ref('school.group_school_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="ir_rule_attendance_student" model="ir.rule">
            <field name="name">Student Own Record Attendance</field>
            <field name="model_id" ref="school.model_attendance_attendance"/>
            <field name="domain_force">[('student_ids.student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>