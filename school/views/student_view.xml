<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_list_view_school" model="ir.ui.view">
        <field name="name">student.list.view.school</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list string="Student">

                <field name="partner_id"/>
                <field name="email"/>
                <field name="phone_no"/>
                <field name="dob"/>
                <field name="age"/>
                <field name="user_id"/>
                <field name="current_date"/>
                <field name="city"/>

                <field name="state"/>
                <field name="standard_id"/>
                <field name="subject_ids"/>
            </list>
        </field>
    </record>

    <record id="student_form_view_school" model="ir.ui.view">
        <field name="name">student.form.view.school</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form string="student">
                <header>
                    <button name="%(school.action_admission_school)d"
                            string="show admission"
                            type="action"/>

                    <button name="object_to_action"
                            type="object"
                            string=" show standard"/>

                    <button name="stat_check"
                            type="object"
                            string="check approved"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_admission,done,running,terminated,alumni"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <field name="image" widget="image" options="{'size': [64, 64]}"/>
                        <group>
                            <field name="partner_id" required="True"/>
                            <field name="email"/>
                            <field name="phone_no"/>
                            <field name="dob"/>
                            <field name="user_id"  groups="school.group_school_admin"/>
                            <field name="age"/>
                            <div>
                                <strong>Adress:</strong>
                            </div>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" placeholder="State" class="o_address_state"
                                       options="{'no_open': True, 'no_quick_create': True}"
                                       context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" placeholder="Country" class="o_address_country"
                                           options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="current_date"/>
                            <field name="standard_id"/>
                            <field name="hobby_ids" placeholder="choise hobby" widget="many2many_tags" nolabel="1"/>
                        </group>
<!--                        <group string="Subject">-->
<!--                             <field name="subject_ids" nolabel="1"/>-->
<!--                        </group>-->
                    </group>
                    <notebook>
                        <page string="Exam result" name="groups">
                            <field name="exam_result_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="exam_id" domain="[('partner_ids','in',student_id)]"/>
                                    <field name="student_id" readonly="1"/>
                                    <field name="subject" readonly="1"/>
                                    <field name="total_mark" readonly="1"/>
                                    <field name="passing_mark" readonly="1"/>
                                    <field name="obtain_mark"/>
                                    <field name="result"/>
                                    <field name="pr"/>
                                </list>
                            </field>
                        </page>
                        <page string="subject" name="groups">
                            <field name="sub_m2m_ids" placeholder="select subject"
                                   domain="[('standard_id', '=', standard_id)]"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="student_search_view_school" model="ir.ui.view">
        <field name="name">student.search.view.school</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <search string="student">
                <field name="email"/>
                <field name="phone_no"/>
                <field name="city"/>
                <group>
                    <filter name="Age" string="Age" context="{'group by':'age'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="student_kanban_view_school" model="ir.ui.view">
        <field name="name">student.kanban.view.school</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row 0">
                            <div class="col-6 ">
                                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                                <strong></strong>
                            </div>
                            <div class="col-6  text-end">


                            </div>

                            <div class="col-6  ">
                                <strong>date:</strong>

                            </div>
                            <div class="col-6  text-end">
                                <field name="current_date"/>

                            </div>
                            <div class="col-6  ">
                                <strong>name:</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="partner_id"/>
                            </div>

                            <div class=" col-6">
                                <strong>Email:</strong>
                            </div>
                            <div class=" col-6  text-end">
                                <field name="email"/>
                            </div>
                            <div class=" col-6">

                                <strong>phone number:</strong>
                            </div>
                            <div class=" col-6  text-end">
                                <field name="phone_no"/>
                            </div>
                            <div class=" col-6">
                                <strong>standar:</strong>
                            </div>
                            <div class=" col-6  text-end">
                                <field name="standard_id"/>
                            </div>

                            <div class="col-6">
                                <strong>Date of Birth :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="dob"/>
                            </div>


                            <div class="col-6">
                                <strong>Age :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="age"/>
                            </div>


                            <div class="col-6">
                                <strong>City :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="city"/>
                            </div>

                            <div class="col-6">
                                <strong>Subject :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="subject_ids"/>
                            </div>

                            <div class="col-6">
                                <strong>State :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="state"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>

        </field>
    </record>


    <record id="student_action_school" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">kanban,list,form,search</field>
        <field name="domain">[('state','!=', 'draft')]</field>
        <field name="view_id" ref="student_kanban_view_school"/>
        <field name="search_view_id" ref="student_search_view_school"/>
    </record>

    <record id="action_draft_student_school" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">kanban,list,form,search</field>
        <field name="domain">[('state','=', 'draft')]</field>
        <field name="view_id" ref="student_kanban_view_school"/>
        <field name="search_view_id" ref="student_search_view_school"/>
    </record>

    <menuitem id="school_main_menu" name="School"/>
    <menuitem id="school_profile_menu" name="Profile" parent="school_main_menu" sequence="2"/>
    <menuitem id="school_student_menu" name="Student" parent="school_profile_menu" sequence="2"
              action="student_action_school"/>
    <menuitem id="school_draft_student_menu" name="in draft Student" parent="school_profile_menu" sequence="3"
              action="action_draft_student_school"/>


</odoo>