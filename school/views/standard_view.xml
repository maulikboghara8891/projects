<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="standard_list_view_school" model="ir.ui.view">
        <field name="name">standard.list.view.school</field>
        <field name="model">standard.standard</field>
        <field name="arch" type="xml">
            <list string="Standard">
                <field name="st_class"/>
                <field name="student_ids" widget="many2many_tags"/>
                <field name="teacher_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="standard_form_view_school" model="ir.ui.view">
        <field name="name">standard.form.view.school</field>
        <field name="model">standard.standard</field>
        <field name="arch" type="xml">
            <form string="Standard">
                <sheet>
                    <group>
                        <field name="st_class" required="True"/>
                        <!--                        <field name="stand_ids" />-->
                    </group>


                </sheet>
            </form>
        </field>
    </record>
    <record id="standard_search_view_school" model="ir.ui.view">
        <field name="name">standard.search.view.school</field>
        <field name="model">standard.standard</field>
        <field name="arch" type="xml">
            <search string="Standard">
                <field name="st_class"/>
                <!--                <field name="stand_ids" />-->


            </search>
        </field>
    </record>

    <record id="standard_kanban_view_school" model="ir.ui.view">
        <field name="name">standard.kanban.view.school</field>
        <field name="model">standard.standard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row 0">
                            <div class="col-6  ">
                                <strong>class:</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="st_class"/>

                            </div>
                            <div class="col-6  ">
                                <strong>students:</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="student_ids"/>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_standard_school" model="ir.actions.act_window">
        <field name="name">action.standard.school</field>
        <field name="res_model">standard.standard</field>
        <field name="view_mode">list,form,search,kanban</field>
        <field name="view_id" ref="standard_list_view_school"/>
        <field name="search_view_id" ref="standard_search_view_school"/>
    </record>


    <menuitem id="school_standard_menu" name="Standard" parent="school_main_menu" action="action_standard_school"
              sequence="4"/>


</odoo>