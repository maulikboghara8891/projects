<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="exam_list_view_school" model="ir.ui.view">
        <field name="name">exam.list.view.school</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <list string="Exam">
                <field name="exam"/>
                <field name="standard_id"/>
                <field name="subject_id"/>
                <field name="total_mark"/>
                <field name="passing_mark"/>

                <field name="partner_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="exam_form_view_school" model="ir.ui.view">
        <field name="name">exam.form.view.school</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <form string="Exam">
                <sheet>
                    <group>
                        <field name="exam"/>
                        <field name="standard_id"/>
                        <field name="subject_id" domain="[('standard_id', '=', standard_id)]"/>

                        <field name="total_mark"/>
                        <field name="passing_mark"/>
                        <field name="partner_ids" placeholder="select student" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group>
                        <!--                        <field name="stand_ids"  optional="hide"/>-->
                    </group>


                </sheet>
            </form>
        </field>
    </record>
    <record id="exam_search_view_school" model="ir.ui.view">
        <field name="name">exam.search.view.school</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <search string="Exam">
                <!--                <field name="st_class" />-->
                <!--                <field name="stand_ids" />-->


            </search>
        </field>
    </record>

    <record id="exam_kanban_view_school" model="ir.ui.view">
        <field name="name">exam.kanban.view.school</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row 0">
                            <div class="col-6  ">
                                <strong>class:</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="exam"/>

                            </div>
                            <div class="col-6  ">
                                <strong>students:</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="standard_id"/>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_exam_school" model="ir.actions.act_window">
        <field name="name">action.exam.school</field>
        <field name="res_model">exam.exam</field>
        <field name="view_mode">list,form,search,kanban</field>
        <field name="view_id" ref="exam_list_view_school"/>
        <field name="search_view_id" ref="exam_search_view_school"/>
    </record>


    <menuitem id="school_exam_menu" name="Exam" parent="school_main_menu" action="action_exam_school" sequence="6"/>
    <!--     <menuitem id="school_exam_data_menu" name="exam" parent="school_exam_menu" action="action_exam_school" sequence="1"/>-->


</odoo>