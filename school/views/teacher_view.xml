<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="teacher_list_view_school" model="ir.ui.view">
        <field name="name">teacher.list.view.school</field>
        <field name="model">teacher.teacher</field>
        <field name="arch" type="xml">
            <list string="Teacher">
                <field name="partner_id"/>
                <field name="email"/>
                <field name="phone_no"/>
                <field name="dob"/>
                <field name="age"/>
                <field name="current_date"/>
                <field name="city"/>
                <field name="subject_id"/>
                <field name="state"/>
                <field name="standard_id"/>


            </list>
        </field>
    </record>

    <record id="teacher_form_view_school" model="ir.ui.view">
        <field name="name">teacher.form.view.school</field>
        <field name="model">teacher.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_admission,running,terminated,alumni"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" required="True"/>
                            <field name="email"/>
                            <field name="phone_no"/>
                            <field name="dob"/>
                            <field name="age"/>
                            <div>
                                <strong>Adress:</strong>
                            </div>
                            <div class="o_address_format">
                                <field name="street" readonly="True" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" readonly="True" placeholder="Street 2..."
                                       class="o_address_street"/>
                                <field name="city" readonly="True" placeholder="City" class="o_address_city"/>
                                <field name="state_id" readonly="True" placeholder="State" class="o_address_state"
                                       options="{'no_open': True, 'no_quick_create': True}"
                                       context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" readonly="True" placeholder="ZIP" class="o_address_zip"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" readonly="True" placeholder="Country"
                                           class="o_address_country"
                                           options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="current_date"/>
                            <field name="standard_id"/>
                            <field name="subject_id" domain="[('standard_id', '=', standard_id)]"/>

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="teacher_kanban_view_school" model="ir.ui.view">
        <field name="name">teacher.kanban.view.school</field>
        <field name="model">teacher.teacher</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row 0">
                            <div class="col-6  ">
                                <strong>date:</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="current_date"/>
                            </div>
                            <div class="col-6  ">
                                <strong>name:</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="partner_id"/>
                            </div>

                            <div class=" col-6">
                                <strong>Email:</strong>
                            </div>
                            <div class=" col-6  text-end">
                                <field name="email"/>
                            </div>
                            <div class=" col-6">
                                <strong>phone number:</strong>
                            </div>
                            <div class=" col-6  text-end">
                                <field name="phone_no"/>
                            </div>
                            <div class=" col-6">
                                <strong>standar:</strong>
                            </div>
                            <div class=" col-6  text-end">
                                <field name="standard_id"/>
                            </div>

                            <div class="col-6">
                                <strong>Date of Birth :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="dob"/>
                            </div>


                            <div class="col-6">
                                <strong>Age :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="age"/>
                            </div>


                            <div class="col-6">
                                <strong>City :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="city"/>
                            </div>

                            <div class="col-6">
                                <strong>Subject :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="subject_id"/>
                            </div>

                            <div class="col-6">
                                <strong>State :</strong>
                            </div>
                            <div class="col-6  text-end">
                                <field name="state"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>

        </field>
    </record>

    <record id="action_teacher_school" model="ir.actions.act_window">
        <field name="name">action.teacher.school</field>
        <field name="res_model">teacher.teacher</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_id" ref="teacher_list_view_school"/>


    </record>

    <menuitem id="school_Teacher_menu"
              name="Teacher"
              parent="school_profile_menu"
              action="action_teacher_school"

    />


</odoo>