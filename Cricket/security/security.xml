<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_cricket_access">
            <field name="name">Cricket</field>
            <field name="sequence">21</field>
        </record>

        <record model="res.groups.privilege" id="res_group_cricket_role">
            <field name="name">cricket</field>
            <field name="category_id" ref="module_cricket_access"/>
        </record>

        <record id="group_cricket_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_group_cricket_role"/>
        </record>


        <record id="group_cricket_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="privilege_id" ref="res_group_cricket_role"/>
            <field name="implied_ids" eval="[(4, ref('group_cricket_user'))]"/>
        </record>


    </data>
</odoo>