<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="coach_list_view_cricket" model="ir.ui.view">
        <field name="name">coach.list.view.cricket</field>
        <field name="model">team.coach</field>
        <field name="arch" type="xml">
            <list string="player">
                <field name="name"/>
                <field name="phone"/>
                <field name="age"/>
                <field name="experience"/>
                <field name="specialization"/>
                <field name="team_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="coach_form_view_cricket" model="ir.ui.view">
        <field name="name">coach.form.view.cricket</field>
        <field name="model">team.coach</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="age"/>
                        <field name="experience"  />
                        <field name="specialization"/>

                    </group>
                    <notebook>
                        <page string="Teams">
                            <field name="team_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="coach_search_view_cricket" model="ir.ui.view">
        <field name="name">coach.search.view.cricket</field>
        <field name="model">team.coach</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="specialization"/>
            </search>
        </field>
    </record>

