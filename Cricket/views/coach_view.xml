    <record id="action_coach_cricket" model="ir.actions.act_window">
        <field name="name">Coach</field>
        <field name="res_model">team.coach</field>
        <field name="view_mode">list,form,search</field>
        <field name="view_id" ref="coach_list_view_cricket"/>
        <field name="search_view_id" ref="coach_search_view_cricket"/>
    </record>


    <menuitem id="add_main_menu" parent="cricket_main_menu" name="Add" sequence="1">
