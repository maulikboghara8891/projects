<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tname_list_view_cricket" model="ir.ui.view">
        <field name="name">tname.list.view.cricket</field>
        <field name="model">team.name</field>
        <field name="arch" type="xml">
            <list >
                <field name="name"/>
                <field name="short_name"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <record id="tname_form_view_cricket" model="ir.ui.view">
        <field name="name">tname.form.view.cricket</field>
        <field name="model">team.name</field>
        <field name="arch" type="xml">
            <form >
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="short_name" required="1"/>
                        <field name="city"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="tname_search_view_cricket" model="ir.ui.view">
        <field name="name">tname.search.view.cricket</field>
        <field name="model">team.name</field>
        <field name="arch" type="xml">
            <search>
               <field name="short_name" required="1"/>
            </search>
        </field>
    </record>

