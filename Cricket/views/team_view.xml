    <record id="action_team_cricket" model="ir.actions.act_window">
        <field name="name">team</field>
        <field name="res_model">cricket.team</field>
        <field name="view_mode">list,form,search</field>
        <field name="view_id" ref="team_list_view_cricket"/>
        <field name="search_view_id" ref="team_search_view_cricket"/>
