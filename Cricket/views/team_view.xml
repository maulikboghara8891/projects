<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="team_list_view_cricket" model="ir.ui.view">
        <field name="name">team.list.view.cricket</field>
        <field name="model">cricket.team</field>
        <field name="arch" type="xml">
            <list string="team">
                <field name="tournament_id" />
                <field name="team_id" />
                <field name="group" optional="hide"/>
                <field name="player_ids" widget="many2many_tags"/>
                <field name="total_matches"/>
                <field name="total_wins"/>
                <field name="points" />
                <field name="lost" optional="hide"/>
                <field name="tie" optional="hide"/>
                <field name="captain_id" optional="hide" />
                <field name="coach_ids" widget="many2many_tags" optional="hide" />

            </list>
        </field>
    </record>

    <record id="team_form_view_cricket" model="ir.ui.view">
        <field name="name">team.form.view.cricket</field>
        <field name="model">cricket.team</field>
        <field name="arch" type="xml">
            <form string="team">
                <sheet>
                    <group>
                        <field name="tournament_id"  required="1"/>
                        <field name="team_id" required="1"/>
                        <field name="group"  />
                        <field name="player_ids" />
                         <field name="captain_id"  domain="[('id','in',player_ids)]" options="{'no_create': True}"/>
                        <field name="coach_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="team_search_view_cricket" model="ir.ui.view">
        <field name="name">team.search.view.cricket</field>
        <field name="model">cricket.team</field>
        <field name="arch" type="xml">
            <search string="team">
                <field name="name"/>
            </search>
        </field>
    </record>

