<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="venue_list_view_cricket" model="ir.ui.view">
        <field name="name">venue.list.view.cricket</field>
        <field name="model">cricket.venue</field>
        <field name="arch" type="xml">
            <list >
                <field name="name" required="1"/>
                <field name="street"/>
                <field name="city"/>
                <field name="state"/>
                <field name="country"/>
            </list>
        </field>
    </record>

    <record id="venue_form_view_cricket" model="ir.ui.view">
        <field name="name">venue.form.view.cricket</field>
        <field name="model">cricket.venue</field>
        <field name="arch" type="xml">
            <form >
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="street"/>
                        <field name="city"/>
                        <field name="state"/>
                        <field name="country"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="venue_search_view_cricket" model="ir.ui.view">
        <field name="name">venue.search.view.cricket</field>
        <field name="model">cricket.venue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>

            </search>
        </field>
    </record>

