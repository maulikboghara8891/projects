    <record id="action_venue_cricket" model="ir.actions.act_window">
        <field name="name">venue</field>
        <field name="res_model">cricket.venue</field>
        <field name="view_mode">list,form,search</field>
        <field name="view_id" ref="venue_list_view_cricket"/>
