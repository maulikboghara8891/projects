<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_sale_category_form" model="ir.ui.view">
        <field name="name">res.config.sale.category.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sale_shipping_setting_container']" position="after">

                <block title="Category" name="sale_shipping_setting_category">
                    <group>
                        <field name="category_ids" widget="many2many_tags"/>
                    </group>

                </block>
            </xpath>


        </field>
    </record>
</odoo>
