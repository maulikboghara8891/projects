<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_product" model="ir.actions.act_window">
        <field name="name">My Model</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="product.product_template_kanban_view"/>
    </record>

    <menuitem id="shoping_main_menu" name="Shopping"/>
    <menuitem
        id="menu_product"
        name="product"
        parent="shoping_main_menu"
        action="action_product"
        sequence="2"/>


    <record id="action_pos_menu" model="ir.actions.act_window">
        <field name="name">action.pos.menu</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="point_of_sale.view_pos_config_kanban"/>
    </record>
    <menuitem
        id="menu_pos"
        name="Dashboard"
        parent="shoping_main_menu"
        action="action_pos_menu"
        sequence="1"/>

</odoo>