<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="timesheet_view_list" model="ir.ui.view">
            <field name="model">timesheet.timesheet</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="project_id" domain=""/>
                    <field name="task_id" domain="[('project_id', '=', project_id), ('display_task', '=', True)]"/>
                    <field name="time_spent"  sum="Total"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
