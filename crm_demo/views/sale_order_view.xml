<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="timesheet_update_server_action"
            model="ir.actions.server">
        <field name="name">Timesheet Update</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_timesheet_update()
        </field>
    </record>

    <record id="sale_order_inherit_view_form" model="ir.ui.view">
        <field name="name">sale.order.inherit.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_reporting']" position="after">
                <group name='timesheet_date' string="TimeSheet Date">
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="after">
