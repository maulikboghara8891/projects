<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_project_view_list" model="ir.ui.view">
        <field name="name">project.project.view.form</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="project_id" />
                <field name="task_id" domain="[('project_id', '=', project_id), ('display_task', '=', True)]"/>
                <field name="unit_amount" widget="timesheet_uom" sum="Total"/>
<!--                <field name="related_task_id" readonly="1"/>-->
            </list>

        </field>
    </record>

